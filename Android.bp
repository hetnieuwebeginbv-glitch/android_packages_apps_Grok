android_app {
    name: "Grok",
    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
        "aidl/**/*.aidl",
    ],
    aidl: {
        include_dirs: ["packages/apps/AetherCore/aidl"],
    },
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    privileged: true,
    product_specific: true,
    platform_apis: true,
}
